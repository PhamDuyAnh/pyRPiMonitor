# pyRPiMonitor: legacy RPIMONITOR_ variable names retained for compatibility.
# Non-secret defaults. No credential values belong in this example or repository.
RPIMONITOR_INTERVAL=60
RPIMONITOR_MQTT_HOST=127.0.0.1
RPIMONITOR_MQTT_PORT=1883
# Omit interface to select an active default route, then prefer wlan0.
# RPIMONITOR_INTERFACE=wlan0
# Define these only in the private EnvironmentFile, outside the source tree:
# RPIMONITOR_MQTT_USERNAME=
# RPIMONITOR_MQTT_PASSWORD=
